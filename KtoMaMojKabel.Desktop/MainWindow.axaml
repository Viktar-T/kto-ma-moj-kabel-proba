<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KtoMaMojKabel.Desktop.MainWindow"
        Title="Kto ma mój kabel" Width="480" Height="420">
    <StackPanel Margin="16" Spacing="8">
        <TextBox x:Name="CoPole" PlaceholderText="co pożyczam" />
        <TextBox x:Name="KomuPole" PlaceholderText="komu" />
        <Button x:Name="ZapiszPrzycisk" Content="Zapisz" Click="Zapisz_Click" />
        <TextBlock x:Name="Blad" Foreground="DarkRed" />
        <TextBlock x:Name="Komunikat" Text="Nic nie jest na zewnątrz." />
        <ListBox x:Name="Lista" />
    </StackPanel>
</Window>
